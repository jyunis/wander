# Cairn — environment. Copy to .env; all fields have safe defaults for a
# LAN-only single-user box, so an empty .env boots. Pydantic BaseSettings
# reads CAIRN_*-prefixed vars (see config.py).

# --- Server ----------------------------------------------------------------
CAIRN_HOST=0.0.0.0
CAIRN_PORT=9931
LOG_LEVEL=INFO

# --- Storage / caches (paths inside the container; ./data is mounted) ------
CAIRN_DATA_DIR=/data
# CAIRN_DB_PATH=/data/cairn.db
# CAIRN_TILE_CACHE_DIR=/data/tiles
# CAIRN_OSM_CACHE_DIR=/data/osm-cache

# --- External services (public, no key — TLC-12) ---------------------------
# CAIRN_OVERPASS_URL=https://overpass-api.de/api/interpreter
# CAIRN_TERRARIUM_URL=https://s3.amazonaws.com/elevation-tiles-prod/terrarium
# USFS MVUM forest roads (national-forest roads OSM often lacks). Public, no key.
# CAIRN_MVUM_ENABLED=true
# CAIRN_MVUM_URL=https://apps.fs.usda.gov/arcx/rest/services/EDW/EDW_MVUM_01/MapServer/1/query
# Descriptive UA identifying Cairn to shared public endpoints (TLC-5).
# CAIRN_USER_AGENT=cairn/0.1 (self-hosted campsite scorer; +https://cairn.home.arpa)

# --- Caps (TLC-4) ----------------------------------------------------------
# CAIRN_MAX_BBOX_AREA_KM2=2500
# CAIRN_MAX_CANDIDATES=5000
# CAIRN_MAX_WALLCLOCK_SECONDS=120

# --- Memory invariants (TLC-13 / TLC-14) -----------------------------------
# CAIRN_TILE_LRU_CAP=16
# CAIRN_INGEST_CHUNK_SIZE=5000

# --- Terrain ---------------------------------------------------------------
# CAIRN_TERRARIUM_ZOOM=12

# --- Cache freshness (seconds) ---------------------------------------------
# CAIRN_OSM_CACHE_TTL=604800
# CAIRN_TILE_CACHE_TTL=2592000
